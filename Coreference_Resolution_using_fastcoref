      "source": [
        "\n",
        "\n",
        "!pip -q install fastcoref\n",
        "import logging\n",
        "# Suppress warning messages from huggingface_hub\n",
        "logging.getLogger(\"huggingface_hub\").setLevel(logging.ERROR)\n",
        "\n",
        "# Dynamic monkeypatch to fix modern transformers library compatibility\n",
        "import fastcoref.modeling\n",
        "if not hasattr(fastcoref.modeling.FCorefModel, \"all_tied_weights_keys\"):\n",
        "    fastcoref.modeling.FCorefModel.all_tied_weights_keys = {}\n",
        "\n",
        "from fastcoref import FCoref\n",
        "\n",
        "# Initialize the pretrained coreference model\n",
        "model = FCoref(device=\"cpu\")\n",
        "\n",
        "text = (\n",
        "    \"Riya is a computer science student. \"\n",
        "    \"She loves artificial intelligence. \"\n",
        "    \"Riya says she wants to become an AI engineer.\"\n",
        ")\n",
        "\n",
        "# Perform coreference resolution\n",
        "result = model.predict(texts=[text])\n",
        "\n",
        "# Display the original text\n",
        "print(\"Original Text:\")\n",
        "print(text)\n",
        "\n",
        "print(\"\\nCoreference Clusters:\")\n",
        "\n",
        "# Display groups of referring expressions\n",
        "clusters = result[0].get_clusters(as_strings=True)\n",
        "\n",
        "for cluster in clusters:\n",
        "    print(cluster)"
      ]
