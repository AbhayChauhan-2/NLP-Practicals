        "\n",
        "\n",
        "!pip install -q --upgrade gensim\n",
        "\n",
        "import urllib.request\n",
        "import zipfile\n",
        "import os\n",
        "from gensim.models import Word2Vec\n",
        "from gensim.models.word2vec import Text8Corpus\n",
        "\n",
        "# Manually download and extract the text8 dataset to bypass gensim's buggy downloader\n",
        "dataset_url = \"http://mattmahoney.net/dc/text8.zip\"\n",
        "zip_path = \"text8.zip\"\n",
        "corpus_path = \"text8\"\n",
        "\n",
        "if not os.path.exists(corpus_path):\n",
        "    print(\"Downloading text8 dataset manually...\")\n",
        "    urllib.request.urlretrieve(dataset_url, zip_path)\n",
        "    print(\"Extracting text8 dataset...\")\n",
        "    with zipfile.ZipFile(zip_path, 'r') as zip_ref:\n",
        "        zip_ref.extractall()\n",
        "    print(\"Extraction complete!\")\n",
        "\n",
        "# Load dataset using Gensim's native Text8Corpus class\n",
        "print(\"Loading dataset corpus...\")\n",
        "dataset = Text8Corpus(corpus_path)\n",
        "\n",
        "# Train a basic Word2Vec model\n",
        "print(\"Training Word2Vec model...\")\n",
        "model = Word2Vec(sentences=dataset, vector_size=100, window=5, min_count=150, workers=4)\n",
        "\n",
        "# Save the model\n",
        "model.save(\"word2vec_text8.model\")\n",
        "print(\"Model trained and saved successfully!\")\n",
        "\n",
        "# Demonstrate basic operations\n",
        "word_to_test = \"king\"\n",
        "if word_to_test in model.wv:\n",
        "    print(f\"\\nWords most similar to '{word_to_test}':\")\n",
        "    similar_words = model.wv.most_similar(word_to_test, topn=5)\n",
        "    for word, similarity in similar_words:\n",
        "        print(f\"  {word}: {similarity:.4f}\")"
      ]
