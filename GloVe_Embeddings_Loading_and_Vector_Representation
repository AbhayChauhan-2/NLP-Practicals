      "source": [
        "import numpy as np\n",
        "\n",
        "def get_sentence_vector(sentence, model):\n",
        "    # Tokenize sentence and lowercase\n",
        "    words = sentence.lower().split()\n",
        "    # Filter out words that are not in the vocabulary\n",
        "    valid_vectors = [model[w] for w in words if w in model]\n",
        "\n",
        "    if not valid_vectors:\n",
        "        # Return a zero vector if no words are in vocabulary\n",
        "        return np.zeros(model.vector_size)\n",
        "\n",
        "    # Average the vectors\n",
        "    return np.mean(valid_vectors, axis=0)\n",
        "\n",
        "# Example usage\n",
        "sentence_1 = \"Data science is exciting\"\n",
        "sentence_2 = \"Machine learning is fun\"\n",
        "\n",
        "vec_1 = get_sentence_vector(sentence_1, glove_vectors)\n",
        "vec_2 = get_sentence_vector(sentence_2, glove_vectors)\n",
        "\n",
        "# Calculate cosine similarity\n",
        "cosine_similarity = np.dot(vec_1, vec_2) / (np.linalg.norm(vec_1) * np.linalg.norm(vec_2))\n",
        "print(f\"Sentence 1: '{sentence_1}'\")\n",
        "print(f\"Sentence 2: '{sentence_2}'\")\n",
        "print(f\"Cosine Similarity: {cosine_similarity:.4f}\")"
